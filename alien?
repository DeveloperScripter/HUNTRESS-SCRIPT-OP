		for _, obj in ipairs(workspace:GetDescendants()) do
			setPromptInstant(obj, true)
		end
	else
		-- Restore originals
		for prompt in pairs(promptOriginalDurations) do
			setPromptInstant(prompt, false)
		end
	end
end)

