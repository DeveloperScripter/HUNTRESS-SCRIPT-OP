local currentCode = nil
local function scanCode()
	local mappa = workspace:FindFirstChild("MappaPartita", true)
	local armadi = mappa and mappa:FindFirstChild("Armadi")
	if not armadi then
		codeStatus.Text = "Not found"
		codeStatus.TextColor3 = Color3.fromRGB(241, 133, 133)
		currentCode = nil
		return
	end

	for _, foglietto in ipairs(findAllDeep(armadi, "Foglietto")) do
		for i = 1, 5 do
			local carta = foglietto:FindFirstChild("Carta" .. i)
			local scritta = carta and carta:FindFirstChild("Scritta")
			if scritta then
				local digits = {}
				local valid = false
				for j = 1, 4 do
					digits[j] = getText(scritta:FindFirstChild("Cifra" .. j))
					if digits[j] ~= "?" then
						valid = true
					end
				end
				if valid then
					currentCode = table.concat(digits)
					codeStatus.Text = currentCode
					codeStatus.TextColor3 = Color3.fromRGB(106, 225, 171)
					return
				end
			end
		end
	end

	codeStatus.Text = "No code"
	codeStatus.TextColor3 = Color3.fromRGB(241, 133, 133)
	currentCode = nil
end

task.spawn(function()
	while screenGui.Parent do
		scanCode()
		task.wait(2)
	end
