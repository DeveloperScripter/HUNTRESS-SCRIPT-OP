local autoRunning = false

local function promptPart(prompt)
	local parent = prompt and prompt.Parent
	if parent and parent:IsA("Attachment") then parent = parent.Parent end
	if parent and parent:IsA("BasePart") then return parent end
	if parent and parent:IsA("Model") then return parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart", true) end
	return parent and parent:FindFirstChildWhichIsA("BasePart", true) or nil
end

local function fireProximityPrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Parent then return false end
	local part = promptPart(prompt)
	if not part then return false end
	prompt.Enabled = true
	local root = getRoot(player.Character)
	if root and (root.Position - part.Position).Magnitude > math.max(prompt.MaxActivationDistance - 1, 2) then
		root.CFrame = part.CFrame * CFrame.new(0, 2, 0)
		task.wait(0.2)
	end
	local ok = pcall(function()
		if typeof(fireproximityprompt) == "function" then
			fireproximityprompt(prompt)
		else
			prompt:InputHoldBegin()
			task.wait(math.max(prompt.HoldDuration, 0.05))
			prompt:InputHoldEnd()
		end
	end)
	return ok
end

local function findPromptByName(name, nearPos, maxDist)
	maxDist = maxDist or 25
	local best, bestDist = nil, maxDist
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			local matches = obj.Name == name or obj.ActionText == name or obj.ObjectText == name
			local part = promptPart(obj)
			if matches and part then
				local dist = nearPos and (part.Position - nearPos).Magnitude or 0
				if dist <= bestDist then best, bestDist = obj, dist end
			end
		end
	end
	return best
end

local function findNearestPrompt(nearPos, maxDist, name)
	local best, bestDist = nil, maxDist or math.huge
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") and (not name or obj.Name == name or obj.ActionText == name or obj.ObjectText == name) then
			local part = promptPart(obj)
			if part then
				local dist = (part.Position - nearPos).Magnitude
				if dist < bestDist then best, bestDist = obj, dist end
			end
		end
	end
	return best
end

local function setAutoStatus(text, color)
	-- Status messages are intentionally hidden from the Auto panel.
end

local function findNamedInstance(name)
	return workspace:FindFirstChild(name, true)
end

local function findPromptIn(container, promptName)
	if not container then return nil end
	local fallback = nil
	for _, obj in ipairs(container:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			if obj.Name == promptName or obj.ActionText == promptName or obj.ObjectText == promptName then return obj end
			local parent = obj.Parent
			while parent and parent ~= container do
				if parent.Name == promptName then return obj end
				parent = parent.Parent
			end
			if not fallback then fallback = obj end
		end
	end
	return fallback
end

local function waitForPromptIn(container, promptName, timeout)
	local deadline = os.clock() + timeout
	repeat
		if not container or not container.Parent then return nil end
		local prompt = findPromptIn(container, promptName)
		if prompt then return prompt end
		task.wait(0.25)
	until os.clock() >= deadline
	return nil
end

local function findPlacementPoint(index)
	-- Resolve the requested numbered target directly to preserve 1, 2, 3, 4 order.
	return workspace:FindFirstChild("PuntoCarica_" .. index, true)
		or workspace:FindFirstChild("PuntoCarita_" .. index, true)
end

local function waitForPlacementPoint(index, timeout)
	local deadline = os.clock() + timeout
	repeat
		local point = findPlacementPoint(index)
		if point then return point end
		task.wait(0.25)
	until os.clock() >= deadline
	return nil
end

local function findInfilaForPoint(point)
	if not point then return nil end
	local fallback
	for _, obj in ipairs(point:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			if obj.Name == "Infila" or obj.ActionText == "Infila" or obj.ObjectText == "Infila" then return obj end
			local ancestor = obj.Parent
			while ancestor and ancestor ~= point do
				if ancestor.Name == "Infila" then return obj end
				ancestor = ancestor.Parent
			end
			if not fallback then fallback = obj end
		end
	end
	return fallback
end

local function waitForInfilaAtPoint(point, timeout)
	local deadline = os.clock() + timeout
	repeat
		local prompt = findInfilaForPoint(point)
		if prompt then return prompt end
		task.wait(0.25)
	until os.clock() >= deadline
	return nil
end
local function findDetonatorClickDetector()
	local detonator = findNamedInstance("Detonatore")
	if not detonator then return nil end
	return detonator:FindFirstChildWhichIsA("ClickDetector", true)
end

local function runAutoDynamite()
	if autoRunning then return end
	autoRunning = true
	autoDynamiteButton.Text = "RUNNING..."
	autoDynamiteButton.BackgroundColor3 = Color3.fromRGB(120, 50, 30)
	setAutoStatus("Starting auto sequence...", Color3.fromRGB(255, 200, 100))

	task.spawn(function()
		local success, err = pcall(function()
			if not instantPromptOn then
				instantPromptOn = true
				setToggle(promptToggle, promptKnob, promptStatus, true, "ACTIVE")
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA("ProximityPrompt") then setPromptInstant(obj, true) end
				end
			end

			setAutoStatus('Destroying "Vasi"...', Color3.fromRGB(255, 180, 80))
			local vasi = workspace:FindFirstChild("Vasi") or findNamedInstance("Vasi")
			if vasi then vasi:Destroy() end

			for i = 1, 4 do
				setAutoStatus("Teleport to dynamite (" .. i .. "/4)...", Color3.fromRGB(255, 180, 80))
				teleportToUrto("Dinamite")
				task.wait(1)
				local root = getRoot(player.Character)
				local nearPos = root and root.Position or Vector3.new(3197, 1, 3030)
				local dynamitePrompt = findPromptByName("Prendi", nearPos, 35) or findNearestPrompt(nearPos, 35)
				if not dynamitePrompt then
					setAutoStatus("Dynamite pickup prompt not found nearby", Color3.fromRGB(241, 133, 133))
					return
				end
				dynamitePrompt.Enabled = true
				if not fireProximityPrompt(dynamitePrompt) then
					setAutoStatus("Could not fire dynamite pickup prompt", Color3.fromRGB(241, 133, 133))
					return
				end
				task.wait(0.5)
				setAutoStatus("Teleport to PuntoCarica_" .. i .. "...", Color3.fromRGB(255, 180, 80))
				teleportToPosition(3197, 1, 3030)
				task.wait(0.25)
				local point = waitForPlacementPoint(i, 10)
				local infila = waitForInfilaAtPoint(point, 10)
				if not infila then
					setAutoStatus("Infila prompt not found at PuntoCarica_" .. i, Color3.fromRGB(241, 133, 133))
					return
				end
				infila.Enabled = true
				if not fireProximityPrompt(infila) then
					setAutoStatus("Could not fire Infila at PuntoCarica_" .. i, Color3.fromRGB(241, 133, 133))
					return
				end
				task.wait(0.5)
			end

			setAutoStatus("Teleport to key...", Color3.fromRGB(200, 140, 255))
			teleportToUrto("Chiave")
			task.wait(1)
			local root = getRoot(player.Character)
			local nearPos = root and root.Position or Vector3.new(3197, 1, 3030)
			local keyPrompt = findPromptByName("Prendi", nearPos, 35) or findNearestPrompt(nearPos, 35)
			if keyPrompt then keyPrompt.Enabled = true; fireProximityPrompt(keyPrompt) end
			task.wait(0.5)

			setAutoStatus("Teleport to Detonator Room...", Color3.fromRGB(200, 140, 255))
			teleportToPosition(3126, 1, 3126)
			task.wait(0.5)
			local lucchetto = findNamedInstance("Lucchetto")
			local apriPrompt = waitForPromptIn(lucchetto, "Apri", 10)
			if apriPrompt then
				apriPrompt.Enabled = true
				fireProximityPrompt(apriPrompt)
			else
				setAutoStatus('"Apri" prompt not found in Lucchetto', Color3.fromRGB(241, 133, 133))
				return
			end
			task.wait(0.5)

			local detonatore = findNamedInstance("Detonatore")
			local corpoPrompt = waitForPromptIn(detonatore, "Corpo", 10)
			if corpoPrompt then
				corpoPrompt.Enabled = true
				fireProximityPrompt(corpoPrompt)
			else
				setAutoStatus('"Corpo" prompt not found in Detonatore', Color3.fromRGB(241, 133, 133))
				return
			end

			local code = currentCode
			if not code then scanCode(); code = currentCode end
			if not code and codeStatus.Text and codeStatus.Text ~= "Scanning..." and codeStatus.Text ~= "Not found" and codeStatus.Text ~= "No code" then code = codeStatus.Text end
			local event = game:GetService("ReplicatedStorage"):WaitForChild("HR_Detonatore", 5)
			if not event or not event:IsA("RemoteEvent") or not code then
				setAutoStatus("Detonator event or code unavailable", Color3.fromRGB(241, 133, 133))
				return
			end
			local digits = tostring(code):gsub("%D", "")
			if #digits == 0 then
				setAutoStatus("No numeric code found", Color3.fromRGB(241, 133, 133))
				return
			end
			setAutoStatus("Sending detonator code...", Color3.fromRGB(100, 220, 160))
			for digit in digits:gmatch(".") do
				event:FireServer("tasto", digit)
				task.wait(0.1)
			end
			task.wait(1)
			event:FireServer("tasto", "ENTER")
			task.wait(0.5)

			setAutoStatus("Firing detonator ClickDetector...", Color3.fromRGB(200, 140, 255))
			local clickDetector = findDetonatorClickDetector()
			if clickDetector then
				pcall(function()
					if typeof(fireclickdetector) == "function" then fireclickdetector(clickDetector) end
				end)
			end
			task.wait(0.5)
			setAutoStatus("Teleport to 3197, 1, 3030...", Color3.fromRGB(100, 220, 160))
			teleportToPosition(3197, 1, 3030)
			setAutoStatus("Done! Sequence complete.", Color3.fromRGB(106, 225, 171))
		end)
		if not success then
			setAutoStatus("Error: " .. tostring(err), Color3.fromRGB(241, 133, 133))
			warn("[DevScript Auto] " .. tostring(err))
		end
		autoRunning = false
		if autoDynamiteButton and autoDynamiteButton.Parent then
			autoDynamiteButton.Text = "AUTO WIN"
			autoDynamiteButton.BackgroundColor3 = Color3.fromRGB(180, 70, 40)
		end
	end)
end
