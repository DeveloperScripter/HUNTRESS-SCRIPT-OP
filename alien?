local keyPrefixes = { "Mobile_T_", "Mobile_U_", "Armadio_T_", "Armadio_U_" }

local function isKeyContainer(obj)
	for _, prefix in ipairs(keyPrefixes) do
		if obj.Name:match("^" .. prefix) then
			return true
		end
	end
	return false
end

local function highlightKeyContainer(container)
	local count = 0
	if container:IsA("Model") or container:IsA("BasePart") then
		if addHighlight(container, "KeyHighlight") then
			return 1
		end
	end

	for _, obj in ipairs(container:GetDescendants()) do
		if obj:IsA("Model") and addHighlight(obj, "KeyHighlight") then
			count += 1
		end
	end

	if count == 0 then
		for _, obj in ipairs(container:GetDescendants()) do
			if obj:IsA("BasePart") and addHighlight(obj, "KeyHighlight") then
				count += 1
			end
		end
	end
	return count
end

local keyHighlighted = setmetatable({}, { __mode = "k" })

local function highlightKeyTarget(target)
    if not target or keyHighlighted[target] then return end
    if addHighlight(target, "KeyHighlight") then
        keyHighlighted[target] = true
    end
end

local function refreshKeys()
    clearHighlights("KeyHighlight")
    table.clear(keyHighlighted)
    if not keyOn then return end

    -- One scan when enabled; no repeated full-workspace scan each second.
    local descendants = workspace:GetDescendants()
    for _, obj in ipairs(descendants) do
        if isKeyContainer(obj) then
            local containsKey = false
            for _, child in ipairs(obj:GetDescendants()) do
                if child.Name == "Chiave" then
                    containsKey = true
                    break
                end
            end
            if containsKey then highlightKeyTarget(obj) end
        end
    end

    -- Highlight already-dropped keys that are not inside one of the furniture containers.
    for _, obj in ipairs(descendants) do
        if obj.Name == "Chiave" then
            local ancestor = obj.Parent
            local insideContainer = false
            while ancestor and ancestor ~= workspace do
                if isKeyContainer(ancestor) then insideContainer = true break end
                ancestor = ancestor.Parent
            end
            if not insideContainer then
                local target = (obj:IsA("Model") or obj:IsA("BasePart")) and obj
                    or obj:FindFirstAncestorWhichIsA("Model")
                    or obj:FindFirstAncestorWhichIsA("BasePart")
                highlightKeyTarget(target)
            end
        end
    end
    keyStatus.Text = "ACTIVE"
end

keyToggle.MouseButton1Click:Connect(function()
    keyOn = not keyOn
    setToggle(keyToggle, keyKnob, keyStatus, keyOn, "ACTIVE")
    refreshKeys()
end)

-- Detect newly replicated/dropped Chiave items without rescanning the whole map.
workspace.DescendantAdded:Connect(function(obj)
    if not keyOn or obj.Name ~= "Chiave" then return end
    task.defer(function()
        if not keyOn or not obj.Parent then return end
        local ancestor = obj.Parent
        local insideContainer = false
        while ancestor and ancestor ~= workspace do
            if isKeyContainer(ancestor) then
                highlightKeyTarget(ancestor)
                insideContainer = true
                break
            end
            ancestor = ancestor.Parent
        end
        if not insideContainer then
            local target = (obj:IsA("Model") or obj:IsA("BasePart")) and obj
                or obj:FindFirstAncestorWhichIsA("Model")
                or obj:FindFirstAncestorWhichIsA("BasePart")
            highlightKeyTarget(target)
        end
    end)
end)

