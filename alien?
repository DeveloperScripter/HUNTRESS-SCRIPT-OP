    outline = (style and style.outline) or outline or Color3.new(0, 0, 0)
    local h = Instance.new("Highlight")
    h.Name = name
    h.Adornee = target
    h.FillColor = fill
    h.OutlineColor = outline
    h.FillTransparency = highlightTransparency
    h.OutlineTransparency = math.clamp(highlightTransparency * 0.35, 0, 1)
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = target
    highlightRegistry[h] = name
    local labelText = ({DynamiteHighlight="DYNAMITE", SpiderHighlight="SPIDER", KeyHighlight="KEY", PlayerESPHighlight="PLAYER", DetonatorRoomHighlight="DETONATOR ROOM"})[name]
