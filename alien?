local function findUrtoForContainer(container)
    if not container then return nil end
    local urto = container:FindFirstChild("Urto", true)
    if urto and urto:IsA("BasePart") then return urto end
    if urto and urto:IsA("Model") then
        return urto.PrimaryPart or urto:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function findMatchingUrto(itemName)
    local prefixes = {"Armadio_T_", "Armadio_U_", "Mobile_T_", "Mobile_U_"}
    for _, obj in ipairs(workspace:GetDescendants()) do
        local matchesPrefix = false
        for _, prefix in ipairs(prefixes) do
            if obj.Name:match("^" .. prefix) then
                matchesPrefix = true
                break
            end
        end
        if matchesPrefix and #findAllDeep(obj, itemName) > 0 then
            local urto = findUrtoForContainer(obj)
            if urto then return urto end
        end
    end
    return nil
end

local function teleportToUrto(itemName)
    local urto = findMatchingUrto(itemName)
    if urto then
        teleportToCFrame(urto.CFrame)
    else
        warn("No matching Urto found for " .. itemName)
    end
end

local function findPlayerByName(query)
    query = string.lower((query or ""):gsub("^%s*(.-)%s*$", "%1"))
    if query == "" then return nil end
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            if string.lower(other.Name) == query or string.lower(other.DisplayName) == query then
                return other
            end
        end
    end
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and (string.find(string.lower(other.Name), query, 1, true) or string.find(string.lower(other.DisplayName), query, 1, true)) then
            return other
        end
    end
    return nil
end

