local function makeTab(label)
    local button = Instance.new("TextButton")
    button.Name = label .. "Tab"
    button.Size = UDim2.new(0, ({All=38, Visual=50, Teleport=60, Misc=44, Auto=40, Settings=54})[label] or 54, 1, 0)
    button.BackgroundColor3 = Color3.fromRGB(35, 43, 57)
    button.Text = label
    button.TextColor3 = Color3.fromRGB(190, 201, 218)
    button.TextSize = 10
    button.Font = Enum.Font.GothamBold
    button.AutoButtonColor = true
    button.Parent = tabBar
    corner(button, 8)
    tabButtons[label] = button
    button.MouseButton1Click:Connect(function()
        activeTab = label
        if applyTabFilter then applyTabFilter() end
    end)
end

