applyTabFilter = function()
    for label, button in pairs(tabButtons) do
        button.BackgroundColor3 = label == activeTab and Color3.fromRGB(48, 112, 161) or Color3.fromRGB(35, 43, 57)
        button.TextColor3 = label == activeTab and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(190, 201, 218)
    end
    for _, child in ipairs(content:GetChildren()) do
        if child:IsA("GuiObject") then
            local name = child.Name
            local visible = activeTab == "All"
            if activeTab == "Visual" then
                visible = name == "Category_ESP" or name == "DynamiteCard" or name == "SpiderCard" or name == "Key/Card" or name == "PlayersESPCard" or name == "ESPVisualTextCard"
            elseif activeTab == "Teleport" then
                visible = name == "Category_TeleportManager" or name == "PlayerTeleportCard" or name == "DetonatorRoomCard" or name == "ExitTeleportCard" or name == "TeleportDynamiteCard" or name == "TeleportKeyCard"
            elseif activeTab == "Misc" then
                visible = name == "Category_Misc" or name == "FullbrightCard" or name == "InstantPromptCard" or name == "NoclipCard"
            elseif activeTab == "Auto" then
                visible = name == "Category_Auto" or name == "AutoDynamiteCard"
            elseif activeTab == "Settings" then
                visible = name == "Category_Information" or name == "ShowCodeCard" or name == "KeybindCard" or name == "Category_HighlightSettings" or name == "HighlightSettingsCard"
            end
            child.Visible = visible
        end
    end
    content.CanvasPosition = Vector2.new(0, 0)
end

local function nextOrder()
	layoutOrder += 1
	return layoutOrder
end

local function category(name)
	local label = Instance.new("TextLabel")
	label.Name = "Category_" .. name:gsub("%s+", "")
	label.Size = UDim2.new(1, 0, 0, 22)
	label.BackgroundTransparency = 1
	label.Text = name:upper()
	label.TextColor3 = Color3.fromRGB(113, 169, 222)
	label.TextSize = 10
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.LayoutOrder = nextOrder()
	label.Parent = content
	return label
end

local function cardBase(name, height)
	local card = Instance.new("Frame")
	card.Name = name
	card.Size = UDim2.new(1, 0, 0, height)
	card.BackgroundColor3 = Color3.fromRGB(25, 30, 40)
	card.BorderSizePixel = 0
	card.LayoutOrder = nextOrder()
	card.Parent = content
	corner(card, 13)
	stroke(card, Color3.fromRGB(53, 64, 81), 0.55, 1)
	return card
end

